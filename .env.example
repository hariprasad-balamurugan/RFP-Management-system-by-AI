# Server Configuration
PORT=8000

# MongoDB Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/rfp

# OpenAI API Key (REQUIRED for AI features)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# SMTP Configuration (for sending RFPs to vendors)
# For Gmail: Enable 2FA and create App Password
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=your_email@gmail.com

# IMAP Configuration (for receiving vendor proposals)
# Use same credentials as SMTP for Gmail
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASS=your_app_password_here
